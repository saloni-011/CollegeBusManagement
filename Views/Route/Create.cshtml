@model CollegeBusManagement.Models.BusRoute

@{
    ViewData["Title"] = "Add New Bus Route";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-dark text-white p-4 rounded-top-4">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-25 p-3 rounded-circle me-3">
                        <i class="bi bi-bus-front-fill fs-3 text-white"></i>
                    </div>
                    <div>
                        <h4 class="mb-1 text-white">Create New Bus Route</h4>
                        <p class="mb-0 text-white-50 small">Configure route transit path, seat limits, and fee details.</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="RouteName" class="form-label fw-semibold">Route Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-tag-fill text-muted"></i></span>
                            <input asp-for="RouteName" class="form-control form-control-lg" placeholder="e.g. Route 101 - Kalawad Road" />
                        </div>
                        <span asp-validation-for="RouteName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartPoint" class="form-label fw-semibold">Starting Point / Depot <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-alt-fill text-success"></i></span>
                                <input asp-for="StartPoint" class="form-control" placeholder="e.g. Kotecha Chowk" />
                            </div>
                            <span asp-validation-for="StartPoint" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndPoint" class="form-label fw-semibold">Destination / End Point <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-flag-fill text-danger"></i></span>
                                <input asp-for="EndPoint" class="form-control" placeholder="e.g. College Campus Gate 1" />
                            </div>
                            <span asp-validation-for="EndPoint" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="MonthlyFee" class="form-label fw-semibold">Monthly Fare (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input asp-for="MonthlyFee" type="number" step="0.01" class="form-control" placeholder="1200.00" />
                            </div>
                            <span asp-validation-for="MonthlyFee" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TotalSeats" class="form-label fw-semibold">Total Passenger Seats <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-people-fill text-muted"></i></span>
                                <input asp-for="TotalSeats" type="number" class="form-control" placeholder="40" />
                            </div>
                            <span asp-validation-for="TotalSeats" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Intermediate Stops <small class="text-muted fw-normal">(Optional: comma or new-line separated)</small>
                        </label>
                        <textarea name="initialStops" class="form-control" rows="2" placeholder="e.g. Indira Circle, Atmiya University Junction, Crystal Mall"></textarea>
                        <div class="form-text">You can also manage and set exact timings for intermediate stops anytime on the Route Details page.</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Routes
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg px-4 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Save Route
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
