@model CollegeBusManagement.Models.BusPass

@{
    ViewData["Title"] = "Apply for College Bus Pass";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-dark text-white p-4 rounded-top-4">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary bg-opacity-25 p-3 rounded-circle me-3">
                                <i class="bi bi-ticket-perforated-fill fs-3 text-white"></i>
                            </div>
                            <div>
                                <h4 class="mb-1 text-white">Apply for Bus Pass</h4>
                                <p class="mb-0 text-white-50 small">Fill out your enrollment details to request a transit pass.</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <form asp-action="Apply" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="StudentName" class="form-label fw-semibold">Student Full Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-fill text-muted"></i></span>
                                    <input asp-for="StudentName" class="form-control" placeholder="e.g. John Doe" />
                                </div>
                                <span asp-validation-for="StudentName" class="text-danger small"></span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="RollNumber" class="form-label fw-semibold">College Roll Number <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-card-heading text-muted"></i></span>
                                        <input asp-for="RollNumber" class="form-control" placeholder="e.g. 23CS101" style="text-transform: uppercase;" />
                                    </div>
                                    <span asp-validation-for="RollNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ContactNumber" class="form-label fw-semibold">Contact Phone <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-telephone-fill text-muted"></i></span>
                                        <input asp-for="ContactNumber" class="form-control" placeholder="e.g. 9876543210" />
                                    </div>
                                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Student Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope-fill text-muted"></i></span>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="student@college.edu" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="BusRouteId" class="form-label fw-semibold">Select Bus Route <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-signpost-2-fill text-muted"></i></span>
                                    <select asp-for="BusRouteId" class="form-select form-select-lg" asp-items="ViewBag.Routes">
                                        <option value="">-- Choose your transit route --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="BusRouteId" class="text-danger small"></span>
                                <div class="form-text">Available seat capacity is updated dynamically for each route.</div>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                    <i class="bi bi-send-fill me-2"></i> Submit Pass Application
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Helpful Sidebar -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-white mb-3"><i class="bi bi-info-circle-fill me-2"></i>Application Guidelines</h5>
                        <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                            <li class="d-flex align-items-start">
                                <i class="bi bi-check2-circle fs-6 me-2 mt-1"></i>
                                <span>Applications start in <strong>Pending</strong> status until verified by College Transport Administration.</span>
                            </li>
                            <li class="d-flex align-items-start">
                                <i class="bi bi-check2-circle fs-6 me-2 mt-1"></i>
                                <span>Seats are officially reserved and decremented upon approval.</span>
                            </li>
                            <li class="d-flex align-items-start">
                                <i class="bi bi-check2-circle fs-6 me-2 mt-1"></i>
                                <span>Once approved, you can instantly download or print your <strong>Digital QR Bus Pass</strong> using your Roll Number.</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3"><i class="bi bi-search text-primary me-2"></i>Already Applied?</h6>
                        <p class="text-muted small mb-3">Track the approval progress of your submitted bus pass request anytime.</p>
                        <a asp-action="Status" class="btn btn-outline-primary w-100">
                            <i class="bi bi-clock-history me-1"></i> Check Pass Status
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
